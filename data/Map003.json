{"id":3,"name":"陳媽媽","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":21,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":5,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"SF_People1","direction":4,"pattern":1,"characterIndex":5},"list":[{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["寶寶慢慢張開眼睛，轉動小腦袋、張開嘴巴，小手也慢慢靠近嘴邊。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["寶寶一直在動耶，他是不是肚子餓了？"]},{"code":401,"indent":0,"parameters":["可是我要怎麼知道他真的想喝奶？一定要等他哭嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["不用等到哭，寶寶肚子餓時通常會先出現一些早期訊號，"]},{"code":401,"indent":0,"parameters":["例如開始活動、張嘴、轉頭尋找乳房、伸舌，或把手放到嘴吸吮。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["所以哭不是最早的飢餓訊號？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["沒錯喔！哭通常已經是比較晚期的飢餓訊號，"]},{"code":401,"indent":0,"parameters":["如果能在寶寶出現早期訊號時開始哺乳，"]},{"code":401,"indent":0,"parameters":["通常比較容易讓他安穩地含住乳房。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["那我要怎麼抱他才對？"]},{"code":231,"indent":0,"parameters":[8,"哺餵姿勢",0,0,120,8,45,45,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["哺乳姿勢有很多種，常見的包括搖籃式、橄欖球式、"]},{"code":401,"indent":0,"parameters":["半躺式或生物性哺育姿勢，以及側臥式。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["媽媽並不一定每次都要用同一個姿勢，"]},{"code":401,"indent":0,"parameters":["可以依照自己和寶寶狀況變換不同姿勢，也能減少乳頭受到的壓力。"]},{"code":401,"indent":0,"parameters":["重要的是讓媽媽和寶寶都能舒服～"]},{"code":235,"indent":0,"parameters":[8]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["那正確的哺乳姿勢是甚麼？"]},{"code":231,"indent":0,"parameters":[9,"抱法三要點",0,0,128,8,45,45,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["首先要把身體完整支托好，"]},{"code":401,"indent":0,"parameters":["並記住三個重點："]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["第一，寶寶的頭、頸和身體保持一直線。"]},{"code":401,"indent":0,"parameters":["第二，寶寶的身體靠近媽媽。"]},{"code":401,"indent":0,"parameters":["第三，寶寶的臉面向乳房，鼻子接近乳頭。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["所以不能只有頭轉向媽媽，身體也要一起靠近對嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["完全正確！"]},{"code":235,"indent":0,"parameters":[9]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["媽媽調整好姿勢，寶寶卻張開嘴巴幾次，都沒有順利含住。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["他嘴巴明明張開了，為什麼還是含不好？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["先不要把乳房硬塞進寶寶嘴裡，可以讓他的鼻子接近乳頭，"]},{"code":401,"indent":0,"parameters":["用乳頭輕觸上唇，等嘴巴張得很大時，再把寶寶輕柔地靠近乳房。"]},{"code":401,"indent":0,"parameters":["記得是「把寶寶帶向乳房」，不是媽媽一直把身體往前靠喔～"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["所以要等嘴巴張得夠大再靠近對嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["沒錯喔！"]},{"code":401,"indent":0,"parameters":["良好的含乳不是只有含住乳頭，而是要含住乳頭及較大範圍的乳暈。"]},{"code":231,"indent":0,"parameters":[10,"嬰兒吸法",0,0,40,8,90,90,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["妳看寶寶現在："]},{"code":401,"indent":0,"parameters":["嘴巴張得很大、下唇向外翻、下巴靠近乳房，"]},{"code":401,"indent":0,"parameters":["而且通常上方露出的乳暈會比下方多。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["所以不是要求整個乳暈都含進去"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["沒錯，媽媽也不應該持續感到明顯疼痛，"]},{"code":401,"indent":0,"parameters":["如果在親餵時有劇烈疼痛或持續的刺痛、割裂感、寶寶反覆滑脫，"]},{"code":401,"indent":0,"parameters":["或持續出現嘖嘖聲，就要重新評估姿勢和含乳。"]},{"code":235,"indent":0,"parameters":[10]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["那我怎麼知道他真的有喝到奶？"]},{"code":231,"indent":0,"parameters":[11,"有效哺乳",0,0,16,40,40,40,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["這時就要觀察有效吸吮，乳汁開始流出後，寶寶會逐漸出現比較慢、"]},{"code":401,"indent":0,"parameters":["比較深、且有節奏的吸吮，中間可能稍微停頓，"]},{"code":401,"indent":0,"parameters":["最重要的是：可以看到或聽到吞嚥聲。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["所以不能只看嘴巴一直動，"]},{"code":401,"indent":0,"parameters":["還要觀察有沒有深而有節奏的吸吮和吞嚥。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["對喔！"]},{"code":235,"indent":0,"parameters":[11]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["過了一會兒，寶寶自己鬆開乳房，"]},{"code":401,"indent":0,"parameters":["臉上的表情放鬆，小手也慢慢張開。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["他不吸了，是不是沒有喝到？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["不一定喔！"]},{"code":401,"indent":0,"parameters":["臉部放鬆、手掌張開、不再尋找乳房，而且自己放開乳房，"]},{"code":401,"indent":0,"parameters":["都可能是吃飽後的訊號。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["所以不用規定每次一定喝20或30分鐘？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["對，哺乳要觀察寶寶的訊號，不需要限制固定時間。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["如果寶寶自己放開一側後仍有吃奶訊號，再提供另一側，"]},{"code":401,"indent":0,"parameters":["如果需要中斷哺乳，也不要直接拉開乳房，"]},{"code":401,"indent":0,"parameters":["可以將乾淨手指輕輕放入寶寶嘴角，解除吸力後再移開。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["可是我看不到他到底喝了幾毫升，我要怎麼知道他真的喝夠了？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["不能只看一個表現，要綜合觀察。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["第一，有沒有有效吸吮與吞嚥"]},{"code":401,"indent":0,"parameters":["第二，餵完後寶寶是否比較滿足、放鬆"]},{"code":401,"indent":0,"parameters":["第三，每天的排尿、排便情形及體重變化"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["所以不是只看寶寶有沒有哭或睡著。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["沒錯，不過最可靠的表徵還是寶寶的尿片的次數量和體重增加。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["尿布數量要配合出生天數判斷，出生初期排尿會逐漸增加，"]},{"code":401,"indent":0,"parameters":["出生4-5天後，尿片至少有4-6次以上濕濕重重的感覺，"]},{"code":401,"indent":0,"parameters":["尿尿顏色為淡黃色，代表小星星有喝到足夠的乳汁。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["而體重增加情形是判斷乳汁攝取量最可靠的表徵，"]},{"code":401,"indent":0,"parameters":["通常在出生後10到14天內應恢復到出生體重，"]},{"code":401,"indent":0,"parameters":["寶寶前6個月每個月應增加約500公克。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["新生兒前幾天出現生理性體重下降也很常見，之後會逐漸恢復，"]},{"code":401,"indent":0,"parameters":["但如果體重下降過多、沒有依預期恢復，或排尿不足、持續嗜睡、"]},{"code":401,"indent":0,"parameters":["難以喚醒喝奶，就需要進一步評估。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"陳媽媽"]},{"code":401,"indent":0,"parameters":["那是不是每隔三、四個小時要固定餵一次母乳呢？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["新生兒通常需要頻繁哺乳，但比起只看時鐘，"]},{"code":401,"indent":0,"parameters":["更重要的是觀察寶寶的飢餓訊號，"]},{"code":401,"indent":0,"parameters":["一般新生兒一天大約哺乳8到12次。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["所以看到張嘴、轉頭找乳房，就可以準備餵，不用一定等固定時間。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["對喔～這叫做「依寶寶訊號哺餵」"]},{"code":401,"indent":0,"parameters":["親子同室也能讓爸爸媽媽更容易觀察寶寶，及時回應哺乳需求。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["原來不是一直看時鐘，而是要學會看寶寶在表達什麼。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["沒錯！"]},{"code":401,"indent":0,"parameters":["現在就換你來判斷看看囉～"]},{"code":121,"indent":0,"parameters":[25,25,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":25,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":1},"directionFix":false,"image":{"tileId":0,"characterName":"SF_People1","direction":4,"pattern":1,"characterIndex":5},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["寶寶的頭稍微轉向一側，身體沒有靠近媽媽，只含住乳頭，"]},{"code":401,"indent":0,"parameters":["吸吮時還不斷發出嘖嘖聲。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["媽媽皺著眉說："]},{"code":401,"indent":0,"parameters":["「我的乳頭好痛，可是他一直在吸，這樣應該就是有吃到吧？」"]},{"code":401,"indent":0,"parameters":["請觀察寶寶的姿勢與含乳情形，你會怎麼向媽媽說明並協助她？"]},{"code":102,"indent":0,"parameters":[["可能擺位或含乳不佳，需重新調整","持續吸吮表示含乳正確，維持姿勢","乳頭疼痛是正常現象，忍耐即可"],1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"可能擺位或含乳不佳，需重新調整"]},{"code":101,"indent":1,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":1,"parameters":["很好！"]},{"code":401,"indent":1,"parameters":["不能只看寶寶有沒有吸，還要一起觀察姿勢、含乳、吸吮吞嚥，"]},{"code":401,"indent":1,"parameters":["以及媽媽是否舒適。"]},{"code":101,"indent":1,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":1,"parameters":["當擺位或含乳不理想時，可以重新調整，"]},{"code":401,"indent":1,"parameters":["使寶寶頭頸身體保持一直線、身體靠近媽媽，"]},{"code":401,"