{"id":1,"name":"珊珊護理師","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":42,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":4,"pattern":1,"characterIndex":4},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":41,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"SF_People2","direction":4,"pattern":1,"characterIndex":4},"list":[{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["護理師將乾淨容器、母乳保存袋及吸乳器放在桌上。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["今天媽媽遇到的問題是："]},{"code":401,"indent":0,"parameters":["如果寶寶暫時不在身邊或無法直接吸吮，要怎麼維持乳汁分泌？"]},{"code":401,"indent":0,"parameters":["在去找媽媽以前，我們先把手擠乳的方法整理清楚。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["所以手擠乳不只是把乳汁取出，也能幫助維持乳汁分泌嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["對喔～而且產後盡早開始擠乳，也能刺激乳汁分泌。"]},{"code":401,"indent":0,"parameters":["產後初期若要追奶，白天建議每2到3小時擠一次，"]},{"code":401,"indent":0,"parameters":["每次每邊連續擠3到5分鐘。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["兩邊乳房要輪流擠，擠完一邊，再擠另一邊，"]},{"code":401,"indent":0,"parameters":["一次可能需要15到20分鐘，最多不超過30分鐘，"]},{"code":401,"indent":0,"parameters":["擠到乳房整體變得鬆軟、脹痛感明顯減輕就可以停止。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["那晚上也要照固定時間起床嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["睡前至少要擠一次。半夜如果出現奶脹不適，就需要起床擠乳；"]},{"code":401,"indent":0,"parameters":["如果沒有不舒服，可以等到早上醒來再擠。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["珊珊護理師帶著小妤到手擠乳示範區。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["現在先想想，開始手擠乳以前，需要完成哪些準備？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["要先洗淨雙手、準備乾淨的容器，並選擇舒服的姿勢。"]},{"code":231,"indent":0,"parameters":[12,"擠乳姿勢",0,0,96,40,120,120,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["很好～接著一隻手將容器靠近乳房，另一隻手負責擠乳。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["一隻手將容器靠近乳房。另一隻手的拇指與食指或、中指，呈現C型。"]},{"code":401,"indent":0,"parameters":["放在距離乳頭2-4公分處，輕輕往胸壁方向壓，"]},{"code":401,"indent":0,"parameters":["以大拇指及食指相對的力道，規律地「壓、擠，壓、擠」。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["旋轉變換不同的角度（例如：時鐘方向的 12點與6點、3點與9點），"]},{"code":401,"indent":0,"parameters":["確保乳房各個方向分葉的奶水都能被均勻擠出。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["所以不是直接拉扯乳頭，而是先往胸壁方向壓，再做滾動式推壓。"]},{"code":235,"indent":0,"parameters":[12]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["那除了手擠乳，也可以讓媽媽使用吸乳器嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["可以，吸乳器分為手動和電動兩種，"]},{"code":401,"indent":0,"parameters":["適用的時機為以手擠奶時能順暢流出奶水20-30cc，"]},{"code":401,"indent":0,"parameters":["甚至是噴射狀流出時比較適用。"]},{"code":231,"indent":0,"parameters":[13,"擠乳步驟",0,0,24,32,90,90,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["使用前必須先清洗、消毒；開始抽吸時，"]},{"code":401,"indent":0,"parameters":["要從最小壓力開始，並輪流抽吸兩側乳房，"]},{"code":401,"indent":0,"parameters":["使用結束後，吸乳器也要徹底清潔，並保持乾燥。"]},{"code":235,"indent":0,"parameters":[13]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["如果寶寶是早產兒，暫時還不能親自吸奶，"]},{"code":401,"indent":0,"parameters":["也可以用同樣的方式收集母乳嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["可以，媽媽可以在產後儘早開始擠乳，將母乳收集起來，"]},{"code":401,"indent":0,"parameters":["讓暫時不能親自吸奶的早產兒仍然能喝到媽媽的奶。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["那寶寶六個月以前，除了母乳，還需要補充水或其他食物嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["六個月以前，除非有醫療上的需要，"]},{"code":401,"indent":0,"parameters":["建議完全哺餵母乳，不用另外提供食物或水分。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["學會將母乳擠出後，還要知道如何正確保存，"]},{"code":401,"indent":0,"parameters":["等等媽媽可能也會問妳，如果母乳沒有立即喝完，"]},{"code":401,"indent":0,"parameters":["應該放在哪裡、可以保存多久。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["不同保存位置的時間會不一樣嗎？"]},{"code":231,"indent":0,"parameters":[14,"母乳保存時間",0,0,-16,0,50,50,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["會喔！妳先看看這張母乳保存表。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["母乳放在室溫下，可以保存6到8小時"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["放在絕緣冰桶中，可以保存24小時"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["冷藏室可以保存5天"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["單門冷凍冰箱可以保存2週"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["直立式冰櫃則可以保存6到12個月"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["我整理一下："]},{"code":401,"indent":0,"parameters":["室溫6到8小時、絕緣冰桶24小時、冷藏5天、"]},{"code":401,"indent":0,"parameters":["單門冷凍2週、直立式冰櫃6到12個月。"]},{"code":235,"indent":0,"parameters":[14]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["護理師接著拿出一包冷凍母乳與一瓶冷藏母乳。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["知道保存時間之後，還要學習母乳的解凍與回溫方式。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["冷凍母乳應該先使用哪一包呢？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["奶水解凍採取『後進先出』原則，"]},{"code":401,"indent":0,"parameters":["讓寶寶喝到最新鮮的母乳，營養保存會最佳。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["那冷凍母乳要怎麼解凍呢？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["可以先放入冷藏室解凍，也可以使用流動的溫水慢慢解凍，"]},{"code":401,"indent":0,"parameters":["如果是冷藏母乳，可以將奶瓶放在室溫下，"]},{"code":401,"indent":0,"parameters":["或使用不超過60度的溫水回溫。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["可以使用微波爐或直接用火加熱嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["不可以使用微波爐，也不可以使用直火，否則容易破壞母乳的營養。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["如果解凍後沒有喝完呢？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["解凍後的母乳最好在當餐喝完。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["新擠出的母乳可以直接倒入冷凍母乳嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["不可以，新鮮母乳不能與冷凍母乳混合。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["護理師將教材收好，轉頭看向實習生。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["現在，妳已經完成手擠乳、吸乳器、母乳保存，"]},{"code":401,"indent":0,"parameters":["以及解凍與回溫的學習。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["我準備好了！"]},{"code":401,"indent":0,"parameters":["我會先了解媽媽實際遇到的問題，再運用剛才學到的內容協助她。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["很好。接下來由妳向媽媽說明，"]},{"code":401,"indent":0,"parameters":["我會在旁邊陪著妳，需要時再提醒妳。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["護理師將乾淨容器、母乳保存袋及吸乳器放在桌上。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["讓我們一起去看看吧～"]},{"code":121,"indent":0,"parameters":[42,42,0]},{"code":123,"indent":0,"parameters":["A",0]},{"code":201,"indent":0,"parameters":[0,2,2,4,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":42,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":11,"y":2},
