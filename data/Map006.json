{"id":7,"name":"林媽媽","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":3,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":5,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"SF_People1","direction":6,"pattern":1,"characterIndex":5},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,"林媽媽"]},{"code":401,"indent":0,"parameters":["護理師，我一直很擔心寶寶真的有喝到奶嗎？"]},{"code":401,"indent":0,"parameters":["我才剛生完，母乳真的已經開始分泌了嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["其實，媽媽的身體在懷孕期間就已經開始為哺乳做準備。"]},{"code":231,"indent":0,"parameters":[2,"修正版_泌乳示意圖",0,0,88,64,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["當胎盤娩出後，體內的雌激素與黃體素快速下降，"]},{"code":401,"indent":0,"parameters":["泌乳作用會進一步啟動。"]},{"code":401,"indent":0,"parameters":["這時候，有兩個非常重要的荷爾蒙。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["第一個是「泌乳激素 Prolactin」，主要負責促進乳汁生成。"]},{"code":401,"indent":0,"parameters":["第二個是「催產素 Oxytocin」，寶寶吸吮乳房時可以刺激其釋放，"]},{"code":401,"indent":0,"parameters":["幫助乳汁排出。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["所以可以記成："]},{"code":401,"indent":0,"parameters":["泌乳激素負責「製造乳汁」，"]},{"code":401,"indent":0,"parameters":["催產素負責「排出乳汁」！"]},{"code":235,"indent":0,"parameters":[2]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["沒錯。而且寶寶越早開始有效吸吮，也越能幫助媽媽建立乳汁供應。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"林媽媽"]},{"code":401,"indent":0,"parameters":["可是我現在的奶好像很少。"]},{"code":401,"indent":0,"parameters":["是不是應該等奶多一點再餵？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["不用擔心，產後初期乳汁量本來就不多，不代表媽媽沒有奶。"]},{"code":401,"indent":0,"parameters":["如果媽媽和寶寶狀況穩定，應儘早進行肌膚接觸並開始哺乳。"]},{"code":401,"indent":0,"parameters":["寶寶吸吮不只可以幫助乳汁生成與排出，也會促進催產素釋放。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"林媽媽"]},{"code":401,"indent":0,"parameters":["難怪我餵奶的時候，肚子會有一點一陣一陣縮起來的感覺。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["對。催產素也會促進子宮收縮，有助於產後子宮復舊。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"林媽媽"]},{"code":401,"indent":0,"parameters":["原來哺乳能有這些有好處。那對寶寶呢？"]},{"code":231,"indent":0,"parameters":[3,"嬰兒好處",0,0,176,8,40,40,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["母乳可以提供寶寶成長需要的營養，含有許多免疫與生物活性成分。"]},{"code":401,"indent":0,"parameters":["母乳哺育與降低的部分腸胃道及呼吸道感染風險有關，"]},{"code":401,"indent":0,"parameters":["也能提供寶寶腦部、神經與視覺發展所需要的重要營養。"]},{"code":235,"indent":0,"parameters":[3]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["所以母乳不只是讓寶寶吃飽，也具有營養和免疫保護的功能。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["沒錯～而且媽媽與寶寶哺乳時的肌膚接觸，也能增加親密互動。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["這時，媽媽低頭看著自己剛擠出的乳汁。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"林媽媽"]},{"code":401,"indent":0,"parameters":["可是我的奶黃黃的，而且看起來很少。"]},{"code":401,"indent":0,"parameters":["是不是奶還沒有成熟？"]},{"code":231,"indent":0,"parameters":[4,"初乳",0,0,32,48,45,45,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["這是正常的。"]},{"code":401,"indent":0,"parameters":["寶寶出生初期分泌的乳汁叫做「初乳」，通常呈黃色或金黃色，"]},{"code":401,"indent":0,"parameters":["量雖不多，但是含有豐富的免疫活性成分，非常適合剛出生的寶寶。"]},{"code":235,"indent":0,"parameters":[4]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["那之後母乳會一直都是這個樣子嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["不會喔！"]},{"code":401,"indent":0,"parameters":["母乳會隨著泌乳階段改變。"]},{"code":231,"indent":0,"parameters":[5,"母乳進程",0,0,-32,96,40,40,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["可以簡單記成："]},{"code":401,"indent":0,"parameters":["初乳 → 過渡乳 → 成熟乳"]},{"code":401,"indent":0,"parameters":["所以乳汁的顏色、量和成分慢慢改變，是正常的生理現象。"]},{"code":235,"indent":0,"parameters":[5]},{"code":231,"indent":0,"parameters":[6,"過度乳",0,0,8,32,45,45,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["產後第三天前後，乳汁會慢慢增加，顏色和成分也開始改變，"]},{"code":401,"indent":0,"parameters":["這個階段的乳汁就稱為過渡乳。"]},{"code":235,"indent":0,"parameters":[6]},{"code":231,"indent":0,"parameters":[7,"成熟乳",0,0,16,16,45,45,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["接著從產後第二週開始，一直到停止哺乳之前，"]},{"code":401,"indent":0,"parameters":["媽媽分泌的乳汁就稱為成熟乳。"]},{"code":235,"indent":0,"parameters":[7]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["隨著乳汁逐漸成熟，脂肪含量也會慢慢增加，"]},{"code":401,"indent":0,"parameters":["其中的脂肪不僅能幫助神經髓鞘化，也能促進視網膜的生長與發育。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"林媽媽"]},{"code":401,"indent":0,"parameters":["那寶寶只喝母乳，會不會水分不夠？"]},{"code":401,"indent":0,"parameters":["需要另外喝水嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["如果是健康足月、六個月內純母乳哺餵的寶寶，"]},{"code":401,"indent":0,"parameters":["一般不需要額外補充水分，母乳本身就可以提供寶寶所需要的水分。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["哇～學到好多"]},{"code":401,"indent":0,"parameters":["所以我目前要記住的是："]},{"code":401,"indent":0,"parameters":["泌乳激素負責乳汁生成，催產素幫助乳汁排出、促進子宮收縮。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["初乳量不多但非常珍貴，"]},{"code":401,"indent":0,"parameters":["母乳會從初乳、過渡乳慢慢變成成熟乳，"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["健康足月純母乳寶寶，一般不需要另外喝水，"]},{"code":401,"indent":0,"parameters":["因為母乳已經提供足夠的水分了。"]},{"code":101,"indent":0,"pa