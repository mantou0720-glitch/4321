{"id":1,"name":"蔡媽媽","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":62,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"SF_People1","direction":6,"pattern":1,"characterIndex":5},"list":[{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["實習生獨自走進病房，"]},{"code":401,"indent":0,"parameters":["蔡媽媽今天是剖腹產後的第3天，正準備替寶寶哺乳。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["媽媽您好～我是實習生小妤，"]},{"code":401,"indent":0,"parameters":["今天會由我來了解您和寶寶的哺乳情形，"]},{"code":401,"indent":0,"parameters":["並陪您一起處理遇到的問題。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":0,"parameters":["好，謝謝你，我明天就要出院了，可是餵奶還是不太順利。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":0,"parameters":["近24小時大概親餵了6次，但寶寶吸奶時很少聽到吞嚥聲，"]},{"code":401,"indent":0,"parameters":["今天的濕尿布也比昨天少，體重還沒測量，"]},{"code":401,"indent":0,"parameters":["而且我餵奶時乳頭會痛，乳房也覺得脹脹的。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["我先觀察一次完整的親餵過程，再和您一起看看問題可能出在哪裡。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["媽媽開始親餵，寶寶身體朝上，只有頭部轉向乳房；"]},{"code":401,"indent":0,"parameters":["且寶寶嘴巴張得不大，只含住乳頭，吸吮時還出現嘖嘖聲。"]},{"code":112,"indent":0,"parameters":[]},{"code":101,"indent":1,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":1,"parameters":["寶寶每次吸奶都會發出嘖嘖聲，而且我的乳頭一直很痛，"]},{"code":401,"indent":1,"parameters":["這樣我該怎麼調整呢？"]},{"code":102,"indent":1,"parameters":[["解除吸力，再調整姿勢與含乳","維持原姿勢，延長親餵時間","暫停親餵，擠空乳房後改用奶瓶"],1,0,2,0]},{"code":402,"indent":1,"parameters":[0,"解除吸力，再調整姿勢與含乳"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["我先用乾淨的手指從寶寶嘴角解除吸力，避免直接將寶寶拉開。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["接著讓寶寶的頭和身體保持一直線，使全身面向並貼近您，"]},{"code":401,"indent":2,"parameters":["再協助寶寶張大嘴巴、深含乳房，讓下唇外翻、下巴貼近乳房。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":2,"parameters":["原來不能只把寶寶的頭轉過來，身體也要一起面向我。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["沒錯喔，調整母嬰身體排列與含乳方式，"]},{"code":401,"indent":2,"parameters":["可以幫助寶寶有效吸吮及移出乳汁，也能減少乳頭疼痛與損傷。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["您是剖腹產，如果坐著哺乳時會壓到傷口，"]},{"code":401,"indent":2,"parameters":["也可以依照舒適程度選擇橄欖球式抱姿，避開腹部傷口。"]},{"code":113,"indent":2,"parameters":[]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[1,"維持原姿勢，延長親餵時間"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["寶寶目前的身體排列與含乳方式不佳，"]},{"code":401,"indent":2,"parameters":["繼續維持原有姿勢可能無法改善吸吮，"]},{"code":401,"indent":2,"parameters":["也可能使乳頭持續疼痛或受傷。"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["應該先解除寶寶的吸力，再重新調整姿勢與含乳，"]},{"code":401,"indent":2,"parameters":["再想想正確的處理方式。"]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[2,"暫停親餵，擠空乳房後改用奶瓶"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["現在應該先改善寶寶的姿勢與含乳，不需要立即停止直接哺乳，"]},{"code":401,"indent":2,"parameters":["也不必將兩側乳房完全擠空或改用奶瓶。"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["再想想，應該如何協助寶寶重新含乳。"]},{"code":0,"indent":2,"parameters":[]},{"code":404,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":413,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["實習生重新協助媽媽調整後，"]},{"code":401,"indent":0,"parameters":["寶寶的吸吮變得緩慢、深而有力，也能聽見吞嚥聲。"]},{"code":112,"indent":0,"parameters":[]},{"code":101,"indent":1,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":1,"parameters":["這次餵起來真的比較不痛，餵完後乳房也柔軟了一些，"]},{"code":401,"indent":1,"parameters":["可是寶寶今天的濕尿布比昨天少，體重也還沒測量，"]},{"code":401,"indent":1,"parameters":["現在可以確定他有喝飽嗎？"]},{"code":102,"indent":1,"parameters":[["本次親餵改善，但仍須觀察排泄及體重","聽見吞嚥聲，即代表全天攝取量足夠","濕尿布減少，應立即補充配方奶"],1,0,2,0]},{"code":402,"indent":1,"parameters":[0,"本次親餵改善，但仍須觀察排泄及體重"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["這次可以看到寶寶吸吮得緩慢、深而有力，也能聽見吞嚥聲；"]},{"code":401,"indent":2,"parameters":["您的乳頭疼痛減輕，餵奶後乳房也變得比較柔軟，"]},{"code":401,"indent":2,"parameters":["表示這次的含乳與乳汁移出已有改善。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["不過，還不能只依照一次親餵的表現，"]},{"code":401,"indent":2,"parameters":["判定寶寶一整天攝取的母乳已經足夠。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":2,"parameters":["那還要觀察哪些情況呢？"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["還要綜合觀察寶寶有效吸吮與吞嚥的情形、每天的哺乳頻率、"]},{"code":401,"indent":2,"parameters":["尿液與排便，以及體重變化，濕尿布次數減少需要繼續評估，"]},{"code":401,"indent":2,"parameters":["但不能只根據這一項資料，就立刻認定母乳不足或固定補充配方奶。"]},{"code":113,"indent":2,"parameters":[]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[1,"聽見吞嚥聲，即代表全天攝取量足夠"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["聽見吞嚥聲代表這次親餵的乳汁移出情形有所改善，"]},{"code":401,"indent":2,"parameters":["但不能只依一次親餵，就判定寶寶全天的母乳攝取量足夠。"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["還需要綜合評估哺乳頻率、排泄情形及體重變化，"]},{"code":401,"indent":2,"parameters":["再重新判斷一次。"]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[2,"濕尿布減少，應立即補充配方奶"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["濕尿布次數減少需要持續觀察與評估，但不能只依照這項資料，"]},{"code":401,"indent":2,"parameters":["就判定母乳攝取不足並立即補充配方奶。"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["還需要綜合觀察寶寶的吸吮吞嚥、哺乳頻率、排泄情形及體重變化，"]},{"code":401,"indent":2,"parameters":["再想想。"]},{"code":0,"indent":2,"parameters":[]},{"code":404,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":413,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":0,"parameters":["我明天就要出院了，還是很擔心自己的乳汁不夠，"]},{"code":401,"indent":0,"parameters":["而且回家後晚上也要餵奶，我怕自己沒有辦法好好休息。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"爸爸"]},{"code":401,"indent":0,"parameters":["我願意一起照顧寶寶，但不知道可以怎麼幫忙。"]},{"code":112,"indent":0,"parameters":[]},{"code":101,"indent":1,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":1,"parameters":["那我們回家後應該怎麼安排呢？"]},{"code":102,"indent":1,"parameters":[["每4小時親餵，夜間由爸爸餵配方奶","依飢餓暗示哺餵、觀察攝取指標並尋求支持","每次餵完擠空乳房，以擠乳量判斷是否足夠"],1,0,2,0]},{"code":402,"indent":1,"parameters":[0,"每4小時親餵，夜間由爸爸餵配方奶"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["返家後應依照寶寶的飢餓暗示哺餵，不適合固定限制為每4小時一次，"]},{"code":401,"indent":2,"parameters":["建立母乳哺育期間不建議常規安排媽媽夜間長時間停止哺乳或擠乳，"]},{"code":401,"indent":2,"parameters":["爸爸可以透過換尿布、安撫寶寶、分擔家務，協助媽媽休息。"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["再重新規劃一次返家照護。"]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[1,"依飢餓暗示哺餵、觀察攝取指標並尋求支持"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["返家後可以依照寶寶的飢餓暗示進行哺餵，"]},{"code":401,"indent":2,"parameters":["並持續觀察寶寶吸吮與吞嚥、尿液與排便，以及體重變化，"]},{"code":401,"indent":2,"parameters":["綜合判斷母乳攝取情形。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":2,"parameters":["那晚上也要持續餵奶嗎？"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["建立母乳哺育期間，規律而有效地移出乳汁有助於維持乳汁分泌，"]},{"code":401,"indent":2,"parameters":["因此不建議固定讓您在夜間長時間停止哺乳或擠乳。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["爸爸可以協助換尿布、安撫寶寶、準備餐點及分擔家務，"]},{"code":401,"indent":2,"parameters":["讓您獲得更多休息與支持。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"爸爸"]},{"code":401,"indent":2,"parameters":["了解，那餵奶以外的事情可以交給我，讓媽媽餵完後多休息。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":2,"parameters":["如果回家後還是餵得不順利呢？"]},{"code":101,"indent":2,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":2,"parameters":["如果寶寶持續含乳困難、有效吞嚥減少、排尿持續減少，"]},{"code":401,"indent":2,"parameters":["或體重變化超出預期，"]},{"code":401,"indent":2,"parameters":["應儘早尋求醫療院所或母乳哺育專業人員的協助。"]},{"code":101,"indent":2,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":2,"parameters":["原來如此～謝謝你！"]},{"code":113,"indent":2,"parameters":[]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[2,"每次餵完擠空乳房，以擠乳量判斷是否足夠"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["每次親餵後無需刻意將兩側乳房完全擠空，而且單次擠出的乳汁量，"]},{"code":401,"indent":2,"parameters":["也不能代表寶寶實際攝取的母乳量。"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["應綜合觀察吸吮與吞嚥、排泄及體重變化，"]},{"code":401,"indent":2,"parameters":["再想想更適合的返家照護計畫。"]},{"code":0,"indent":2,"parameters":[]},{"code":404,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":413,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,"蔡媽媽"]},{"code":401,"indent":0,"parameters":["謝謝你的幫忙！"]},{"code":401,"indent":0,"parameters":["經過你的說明，我現在比較知道要怎麼調整哺乳姿勢，"]},{"code":401,"indent":0,"parameters":["也知道回家後該觀察寶寶哪些情況了。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"爸爸"]},{"code":401,"indent":0,"parameters":["謝謝你，我也知道自己能怎麼分擔照顧寶寶，讓媽媽可以多休息，"]},{"code":401,"indent":0,"parameters":["回家後如果遇到問題，我們也會記得尋求協助。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["不用客氣，很高興能幫助你們。祝福媽媽和寶寶哺乳順利，"]},{"code":401,"indent":0,"parameters":["也祝你們一家人平安健康！"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["🎉 第五房通關！"]},{"code":401,"indent":0,"parameters":["你獲得了最後一個密碼：9"]},{"code":201,"indent":0,"parameters