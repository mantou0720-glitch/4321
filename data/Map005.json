{"id":2,"name":"珊珊護理師","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":49,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"SF_People2","direction":4,"pattern":1,"characterIndex":4},"list":[{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["護理師帶著實習生走進病房，"]},{"code":401,"indent":0,"parameters":["葉媽媽正抱著寶寶，爸爸則在一旁整理準備帶回家的物品。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["這位媽媽和寶寶今天準備出院，離開醫院後，"]},{"code":401,"indent":0,"parameters":["媽媽可能會擔心自己能不能照顧好寶寶，"]},{"code":401,"indent":0,"parameters":["也可能不知道要如何繼續哺乳。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["在協助媽媽以前，我們先了解返家後需要哪些支持。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["回家後沒有護理師隨時在旁，媽媽可能會覺得所有事情都要靠自己，"]},{"code":401,"indent":0,"parameters":["但照顧寶寶是家人可以一起參與的事情。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["雖然爸爸不能代替媽媽親餵，但可以準備飲水和餐點，"]},{"code":401,"indent":0,"parameters":["也可以幫寶寶拍嗝、換尿布，讓媽媽有時間好好休息。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["所以家人的協助不只是分擔照顧工作，也能讓媽媽獲得休息。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["沒錯，在幾個月後有些媽媽還會面臨返回職場的問題，"]},{"code":401,"indent":0,"parameters":["若提早做好準備，回到職場後仍可繼續維持母乳哺餵。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["返回職場以前，需要先做哪些準備呢？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["媽媽可以先熟悉擠乳的方法，練習使用吸乳器，"]},{"code":401,"indent":0,"parameters":["並找出適合自己的擠乳時間和頻率，準備用品時，可以攜帶吸乳器、"]},{"code":401,"indent":0,"parameters":["乾淨容器、保冷袋和冰寶，吸乳器的配件也要記得清潔。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["那媽媽上班時，應該在什麼時間擠乳？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["可以依照平常哺餵寶寶的時間，以及乳房的舒適程度安排，"]},{"code":401,"indent":0,"parameters":["上班期間規律移出乳汁，有助於維持乳汁分泌。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["開始上班後，就只能擠乳，不能再直接親餵了嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["還是可以直接親餵，媽媽可以在出門前、回家後，"]},{"code":401,"indent":0,"parameters":["及晚上或休假時，再增加直接哺餵的機會。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["那媽媽在工作時，有可以使用的哺乳或擠乳時間嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["在臺灣，子女未滿兩歲，需要親自哺乳或集乳的受僱者，"]},{"code":401,"indent":0,"parameters":["每天可以有60分鐘的哺集乳時間，而且這段時間視為工作時間，"]},{"code":401,"indent":0,"parameters":["如果延長工作時間達1小時以上，還可以有30分鐘的哺集乳時間。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["那如果媽媽上班時突然滲乳，應該怎麼處理呢？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["可以在胸罩裡放置防溢乳墊，乳墊濕了就要更換，"]},{"code":401,"indent":0,"parameters":["並穿著舒適、有支撐力，但不會過緊的胸罩。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["返回職場後，家人和工作單位的支持也很重要，"]},{"code":401,"indent":0,"parameters":["如果媽媽在哺乳過程中遇到困難，可以詢問醫護人員，"]},{"code":401,"indent":0,"parameters":["或參加母乳哺育支持團體。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["那如果媽媽之後想要停止餵母乳，可以直接停止嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["離乳最好慢慢進行，不要突然完全停止，"]},{"code":401,"indent":0,"parameters":["媽媽可以改用母乳與配方奶交替哺餵，逐漸減少親餵；"]},{"code":401,"indent":0,"parameters":["也可縮短每次餵母乳的時間，再以配方奶補充，約1週可以自然退奶。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["減少哺乳之後，如果媽媽的乳房變得脹脹的呢？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["可以擠出少量乳汁，讓乳房感到舒適即可，不需要每次都完全排空，"]},{"code":401,"indent":0,"parameters":["也可以短時間冷敷。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["退奶期間不要使用束胸或過緊的胸罩壓迫乳房，只要穿著舒適、"]},{"code":401,"indent":0,"parameters":["有支撐力的胸罩，並減少不必要的乳房刺激，乳汁就會逐漸減少。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["每位媽媽在離乳時都需要使用退奶藥嗎？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["退奶藥是否使用，需要由醫師評估，"]},{"code":401,"indent":0,"parameters":["藥物主要是透過抑制泌乳素，預防生理性泌乳，"]},{"code":401,"indent":0,"parameters":["也可能造成頭暈、低血壓、頭痛或噁心等不適。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"小妤"]},{"code":401,"indent":0,"parameters":["原來如此，我學會了！"]},{"code":101,"indent":0,"parameters":["",0,0,2,"珊珊護理師"]},{"code":401,"indent":0,"parameters":["好，那現在就讓我們一起去媽媽身邊，"]},{"code":401,"indent":0,"parameters":["了解她目前的擔心，並協助她解決疑惑吧。"]},{"code":121,"indent":0,"parameters":[51,51,0]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"SF_People2","direction":4,"pattern":1,"characterIndex":4},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":3,"y